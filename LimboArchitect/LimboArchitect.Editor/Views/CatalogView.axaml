<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LimboArchitect.Editor.ViewModels"
             x:Class="LimboArchitect.Editor.Views.CatalogView">

    <StackPanel Margin="15" Background="Red">
        <TextBlock Text="CATALOGO OGGETTI"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White" 
                   Margin="0,0,0,20"/>
        <TextBlock Text="trascinare gli oggetti nel livello"
                   FontSize="16"
                   Foreground="#888888"
                   Margin="0,0,0,15"/>
        
        <StackPanel>
          <ComboBox>  
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
          </ComboBox>

          <ComboBox>
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
          </ComboBox>

          <ComboBox>
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
          </ComboBox>  

          <ComboBox>
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
            <ComboBoxItem/>
          </ComboBox>
        
        </StackPanel>
    </StackPanel>
</UserControl>
